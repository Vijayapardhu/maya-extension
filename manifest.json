{
  "manifest_version": 3,
  "name": "Maya AutoPilot",
  "version": "1.3.9",
  "description": "Auto-fill answers in Maya Grand Assessments with Firebase caching and OpenRouter AI.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "cookies"],
  "host_permissions": [
    "https://api.maya.adityauniversity.in/*",
    "https://maya.adityauniversity.in/*",
    "https://openrouter.ai/*",
    "https://www.gstatic.com/*",
    "https://firestore.googleapis.com/*",
    "https://firebase.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self' https://www.gstatic.com https://firestore.googleapis.com https://firebase.googleapis.com https://openrouter.ai"
  },
  "web_accessible_resources": [
    {
      "resources": ["hook-injected.js", "icons/icon128.png", "firebase-config.js"],
      "matches": ["https://maya.adityauniversity.in/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://maya.adityauniversity.in/grand-assessment/*",
        "https://maya.adityauniversity.in/emp-skills-deep-dive-in/*"
      ],
      "js": ["hook.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://maya.adityauniversity.in/grand-assessment/*",
        "https://maya.adityauniversity.in/emp-skills-deep-dive-in/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Maya AutoPilot",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
